# Example environment variables
# Copy to .env for local development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LiteLLM Configuration
LITELLM_LOG=INFO

# Note: API keys should be passed from the frontend via headers
# DO NOT store API keys in environment variables on the backend
