# Example environment variables for local development
# Copy to .env for local development

# IMPORTANT: No environment variables are REQUIRED for deployment!
# API keys are provided by users via the frontend (BYOK architecture)

# Optional: API Configuration (Railway will set PORT automatically)
PORT=8000
HOST=0.0.0.0

# Optional: CORS Origins for local development
# In production, update app/main.py to specify your frontend domain
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: LiteLLM Configuration
LITELLM_LOG=INFO

# Security Note: NEVER store API keys in backend environment variables
# All API keys are provided by users via the frontend and sent in request headers
